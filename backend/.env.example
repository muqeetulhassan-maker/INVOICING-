PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secure_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (Optional: falls back to embedded storage if postgres credentials not provided)
DB_DRIVER=auto
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=nova_business_db
PG_USER=postgres
PG_PASSWORD=postgres

# AI Receipt Scanner (Google Gemini API Key - Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

